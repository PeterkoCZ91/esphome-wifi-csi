# ESPHome build output and secrets
.esphome/
secrets.yaml

# Node configs are deployment-specific — only the templates are public.
# Put your own nodes in espectre-<name>.yaml and they stay local.
espectre-*.yaml
!espectre-c5-template.yaml
!espectre-c6-template.yaml
mesh_lab/configs/esphome/*.yaml

# Environment files (docker compose reads MQTT_USER/MQTT_PASS from .env)
.env
.env.*

# CSI recordings — contain household presence data (incl. csi_logger archives)
*.db
*.db-wal
*.db-shm
*.db-journal
mesh_lab/data/

# Logs
*.out
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Editors / OS / AI tooling
.vscode/
.idea/
.DS_Store
.claude/
